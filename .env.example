# Copy to .env for development through a Cloudflare Access protected hostname.
# Coolify: use AUTH_MODE=cloudflare and masked runtime environment variables.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
PUBLIC_BASE_URL=https://auditdesk.example.com
DATABASE_PATH=./data/audit.sqlite3
APP_TIMEZONE=America/Toronto

# Cloudflare Access is the only web authentication method.
AUTH_MODE=cloudflare
# Optional override: otherwise generated securely in the persistent data directory.
APP_SECRET_KEY=
CF_ACCESS_ISSUER=
CF_ACCESS_AUDIENCE=
BOOTSTRAP_ADMIN_EMAILS=

# Safe first-install defaults: no external queries or messages on web startup.
SCHEDULER_ENABLED=false
EMAIL_ENABLED=false
TEST_MODE_END_AT=

# Integrations: only required when enabling live intake/delivery.
BRIDGE_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData/itso
BRIDGE_API_KEY=
BRIDGE_AUTH_MODE=bearer
BRIDGE_FIELD_MAP=./bridge_fields.json
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MLS Audit Team
ADMIN_EMAIL=

# Selection defaults, overridden by the managed selection setting.
AUDIT_RATE=0.05
LISTING_WINDOW_HOURS=24
BROKERAGE_COOLDOWN_DAYS=14
BROKER_COOLDOWN_DAYS=14
EMAIL_SUBJECT_TEMPLATE=Listing Audit Request - MLS {mls_number}
EMAIL_BODY_TEMPLATE=Please provide the listing paperwork for MLS {mls_number}, {address}.\n\nListing agent: {agent_name}\nBrokerage: {brokerage_name}\n\nPlease reply with the required documentation.
