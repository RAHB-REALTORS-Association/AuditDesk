# Copy to .env for open development with disposable synthetic fixtures.
# Coolify: use AUTH_MODE=cloudflare and masked runtime environment variables.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765
DATABASE_PATH=./data/audit.sqlite3
APP_TIMEZONE=America/Toronto

# Required only for APP_ENV=test or production; ignored in development.
AUTH_MODE=cloudflare
# Optional override: otherwise generated securely in the persistent data directory.
APP_SECRET_KEY=
CF_ACCESS_ISSUER=
CF_ACCESS_AUDIENCE=
BOOTSTRAP_ADMIN_EMAILS=

# Safe first-install defaults: no external queries or messages on web startup.
SCHEDULER_ENABLED=false
EMAIL_ENABLED=false
TEST_MODE_END_AT=

# Integrations: test/production only. Development ignores these even if populated.
# RESO Web API; the example endpoint is the current Bridge/ITSO provider.
# Legacy BRIDGE_* names remain supported when the RESO_* equivalent is absent.
RESO_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData/itso
RESO_API_KEY=
RESO_AUTH_MODE=bearer
RESO_FIELD_MAP=./bridge_fields.json
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MLS Audit Team
ADMIN_EMAIL=

# Starting workflow defaults; saved Manage settings take precedence.
AUDIT_RATE=0.05
LISTING_WINDOW_HOURS=24
BROKERAGE_COOLDOWN_DAYS=14
BROKER_COOLDOWN_DAYS=14
EMAIL_SUBJECT_TEMPLATE=Listing Audit Request - MLS {mls_number}
EMAIL_BODY_TEMPLATE=Please provide the listing paperwork for MLS {mls_number}, {address}.\n\nListing agent: {agent_name}\nBrokerage: {brokerage_name}\n\nPlease reply with the required documentation.
